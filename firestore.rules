rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Admin records are provisioned manually by the project owner in Firebase Console.
    // A signed-in user must never be able to grant themselves admin access.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Use this collection for sensitive data moved from browser storage to Firestore.
    match /adminData/{document=**} {
      allow read, write: if isAdmin();
    }

    // Deny all other Firestore access unless an explicit rule is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}